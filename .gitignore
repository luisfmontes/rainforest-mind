vigias/log-*.txt
sessoes.json

# Ajuste local de plugin: este projeto não aponta horas. Fica fora do versionado
# porque nomeia um marketplace interno de cliente e o repositório é público.
.claude/settings.local.json

# Config de máquina dos vigias: destino das mensagens e caminhos locais.
# O modelo versionado é vigias/vigia.config.exemplo.json.
vigia.config.json

# Backups automáticos do scripts/ideias.cjs — um por gravação, ficam locais.
.ideias-backups/

# Trava entre sessões paralelas e temporário da escrita atômica.
.ideias.lock
*.jsonl.tmp

# O estado do fluxo e VERSIONADO (docs/rainforest/estado/) - e por ele que outro
# dev retoma a atividade. Fora do git fica so a tagarelice: worktrees e temporarios.

# Os DADOS do usuario sairam do repo em 2026-08-11 e moram em ~/.rainforest.
# O repo e so CODIGO: um plugin que ninguem edita, nem ele. Ver docs/rainforest/
# e a cadeia em hooks/lib/raiz.cjs.
FOCO.md
ideias.jsonl

# Cache da extensao do TDS/AdvPL — fontes gerados, nao sao deste projeto.
.vscode/

# O mecanismo de isolamento de subagente cria worktrees aqui dentro.
# Sem esta linha, `conferir-entrega.cjs` acusa falso positivo na checagem 4
# ("o repo principal foi tocado?") em TODA entrega de agente.
.claude/worktrees/

# Bytecode do Python, gerado ao rodar scripts/medir-injecao.py.
__pycache__/
*.pyc

# Dado do usuario: mora em ~/.rainforest, nunca no repo (publico). Entrou aqui
# uma vez em 2026-08-25, escrito por bateria cuja raiz caiu no fallback do plugin.
ferramentas.jsonl
